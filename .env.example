# Server
PORT=3001
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/quirk

# JWT Auth
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# OpenAI (app fallback key)
OPENAI_API_KEY=your_openai_api_key

# OpenRouter (fallback for users without API key)
OPENROUTER_API_KEY=your_openrouter_api_key

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key

# SendGrid (email delivery)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=your_verified_sender@example.com

# Product Hunt (trend source)
PRODUCT_HUNT_API_TOKEN=your_producthunt_api_token

# Frontend (Vite)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_API_BASE_URL=http://localhost:5173/api
VITE_API_TARGET=http://localhost:3001
