# Server
PORT=3001
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/quirk

# JWT Auth
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# OpenAI (app fallback key)
OPENAI_API_KEY=your_openai_api_key

# OpenRouter (fallback for users without API key)
OPENROUTER_API_KEY=your_openrouter_api_key

# Google Gemini (image prompts)
GEMINI_API_KEY=your_gemini_api_key

# Resend (email delivery)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Quirk <digest@yourdomain.com>

# Product Hunt (trend source)
PRODUCT_HUNT_API_TOKEN=your_producthunt_api_token
